# Copie este arquivo para .env para testar no seu computador.
# No Railway não precisa de .env: as variáveis ficam na aba Variables.
APP_NAME="Deu Fome"
APP_ENV=local
APP_DEBUG=true

# Cria dois restaurantes de exemplo com 29 dias de vendas
DEMO=1

# Administrador do Deu Fome (você)
PLATAFORMA_EMAIL=admin@deufome.local
PLATAFORMA_SENHA=admin12345

# E-mails vão para storage/dados/emails.log em vez de serem enviados
EMAIL_LOG=1

LOG_CHANNEL=stderr
